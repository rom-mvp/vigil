# AgentShield Enclave Mock Service Dockerfile
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 agentshield && \
    mkdir -p /app /app/logs && \
    chown -R agentshield:agentshield /app

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir \
    flask \
    flask-cors \
    pycryptodome \
    && rm -rf /root/.cache/pip

# Copy AgentShield mock service
COPY agentshield_enclave_mock.py .
COPY agentshield_policy.json ./policy.json

# Switch to non-root user
USER agentshield

# Expose port
EXPOSE 8443

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8443/health || exit 1

# Run the enclave mock service
CMD ["python", "agentshield_enclave_mock.py"]
