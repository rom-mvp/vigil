# AgentShield Enclave Mock Service Dockerfile
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 agentshield && \
    mkdir -p /app /app/logs && \
    chown -R agentshield:agentshield /app

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir \
    flask \
    flask-cors \
    cryptography \
    && rm -rf /root/.cache/pip

# Copy AgentShield mock service (upgraded version)
COPY mock_agentshield.py .
COPY agentshield_policy.json .

# Switch to non-root user
USER agentshield

# Expose port
EXPOSE 9000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:9000/health')" || exit 1

# Run the upgraded mock service
CMD ["python", "mock_agentshield.py"]
