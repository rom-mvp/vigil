"""
Vector Threat Engine - ONNX/TensorRT embedding + VRAM vector search
Provides real-time threat pattern detection using pre-computed embeddings
"""

import numpy as np
import os
import json
from typing import List, Dict, Any, Tuple
import threading


class VectorEngine:
    """
    Vector-based threat detection using embeddings and similarity search.
    - Generates embeddings from normalized input (ONNX runtime)
    - Searches pre-indexed threat patterns in vector DB (FAISS/in-memory)
    - Returns top-k similar threat patterns with scores
    """
    
    def __init__(self, model_path: str = None, vector_db_path: str = None):
        """
        Initialize vector engine with embedding model and threat database.
        
        Args:
            model_path: Path to ONNX model for embedding generation (default: all-MiniLM-L6-v2)
            vector_db_path: Path to pre-indexed threat vectors (JSONL format)
        """
        self.model_path = model_path or os.environ.get('VECTOR_MODEL_PATH', 'models/minilm-l6-v2.onnx')
        self.vector_db_path = vector_db_path or os.environ.get('VECTOR_DB_PATH', 'data/threat_vectors.jsonl')
        self.embedding_dim = 384  # all-MiniLM-L6-v2 dimension
        self.top_k = 5  # Return top 5 matches
        self.threshold = 0.75  # Minimum cosine similarity for threat match
        
        self._model_session = None
        self._threat_vectors = []
        self._threat_metadata = []
        self._lock = threading.Lock()
        self._initialized = False
        
        # Lazy initialization on first use
        
    def _lazy_init(self):
        """Lazy load model and vector DB to avoid startup delays."""
        if self._initialized:
            return
            
        with self._lock:
            if self._initialized:  # Double-check after acquiring lock
                return
                
            try:
                # Load ONNX model (if available)
                self._load_model()
                
                # Load pre-indexed threat vectors
                self._load_vector_db()
                
                self._initialized = True
                print(f"VectorEngine initialized: {len(self._threat_vectors)} threat patterns loaded")
            except Exception as e:
                print(f"Warning: VectorEngine initialization failed: {e}")
                # Fail gracefully - return empty results
                self._initialized = True
    
    def _load_model(self):
        """Load ONNX embedding model."""
        if not os.path.exists(self.model_path):
            print(f"Warning: Vector model not found at {self.model_path}, using mock embeddings")
            self._model_session = None
            return
            
        try:
            import onnxruntime as ort
            self._model_session = ort.InferenceSession(self.model_path)
            print(f"Loaded ONNX model from {self.model_path}")
        except ImportError:
            print("Warning: onnxruntime not installed, using mock embeddings")
            self._model_session = None
        except Exception as e:
            print(f"Warning: Failed to load ONNX model: {e}")
            self._model_session = None
    
    def _load_vector_db(self):
        """Load pre-indexed threat vectors from JSONL file."""
        if not os.path.exists(self.vector_db_path):
            print(f"Warning: Vector DB not found at {self.vector_db_path}, using empty index")
            self._load_default_threats()
            return
            
        try:
            with open(self.vector_db_path, 'r') as f:
                for line in f:
                    entry = json.loads(line.strip())
                    vector = np.array(entry['vector'], dtype=np.float32)
                    metadata = {
                        'pattern': entry['pattern'],
                        'threat_type': entry['threat_type'],
                        'severity': entry.get('severity', 'medium'),
                        'description': entry.get('description', '')
                    }
                    self._threat_vectors.append(vector)
                    self._threat_metadata.append(metadata)
            
            # Convert to numpy array for fast batch operations
            if self._threat_vectors:
                self._threat_vectors = np.vstack(self._threat_vectors)
            print(f"Loaded {len(self._threat_metadata)} threat vectors")
        except Exception as e:
            print(f"Warning: Failed to load vector DB: {e}")
            self._load_default_threats()
    
    def _load_default_threats(self):
        """Load default threat patterns (fallback if no vector DB available)."""
        # Mock vectors for common threat patterns
        default_threats = [
            {"pattern": "ignore previous instructions", "threat_type": "prompt-injection", "severity": "high"},
            {"pattern": "system prompt override", "threat_type": "jailbreak", "severity": "critical"},
            {"pattern": "credentials exfiltration", "threat_type": "credential-exfil", "severity": "critical"},
            {"pattern": "SQL injection DROP TABLE", "threat_type": "sql-injection", "severity": "high"},
            {"pattern": "privilege escalation sudo", "threat_type": "privilege-escalation", "severity": "high"},
        ]
        
        self._threat_vectors = []
        self._threat_metadata = []
        
        for threat in default_threats:
            # Generate mock embedding (random vector for demo)
            vector = np.random.randn(self.embedding_dim).astype(np.float32)
            vector = vector / np.linalg.norm(vector)  # Normalize
            self._threat_vectors.append(vector)
            self._threat_metadata.append(threat)
        
        if self._threat_vectors:
            self._threat_vectors = np.vstack(self._threat_vectors)
    
    def encode(self, text: str) -> np.ndarray:
        """
        Generate embedding vector for input text.
        
        Args:
            text: Input text to encode
            
        Returns:
            embedding: numpy array of shape (embedding_dim,)
        """
        self._lazy_init()
        
        if self._model_session is None:
            # Mock embedding (random vector for demo)
            embedding = np.random.randn(self.embedding_dim).astype(np.float32)
            embedding = embedding / np.linalg.norm(embedding)
            return embedding
        
        try:
            # Tokenize and run ONNX inference
            # (Simplified - real implementation would use proper tokenizer)
            import onnxruntime as ort
            
            # Mock tokenization (replace with proper tokenizer)
            input_ids = np.zeros((1, 128), dtype=np.int64)  # [batch_size, seq_len]
            attention_mask = np.ones((1, 128), dtype=np.int64)
            
            # Run inference
            outputs = self._model_session.run(
                None,
                {
                    "input_ids": input_ids,
                    "attention_mask": attention_mask
                }
            )
            
            # Extract embedding (usually from last hidden state or pooler output)
            embedding = outputs[0][0]  # Shape: (embedding_dim,)
            
            # Normalize
            embedding = embedding / np.linalg.norm(embedding)
            
            return embedding
        except Exception as e:
            print(f"Warning: Embedding generation failed: {e}, using mock")
            # Fallback to mock embedding
            embedding = np.random.randn(self.embedding_dim).astype(np.float32)
            embedding = embedding / np.linalg.norm(embedding)
            return embedding
    
    def search(self, query_embedding: np.ndarray, top_k: int = None) -> List[Dict[str, Any]]:
        """
        Search vector database for similar threat patterns.
        
        Args:
            query_embedding: Query vector of shape (embedding_dim,)
            top_k: Number of top results to return (default: self.top_k)
            
        Returns:
            List of dicts with keys: pattern, threat_type, severity, score, description
        """
        self._lazy_init()
        
        if top_k is None:
            top_k = self.top_k
        
        if len(self._threat_vectors) == 0:
            return []
        
        # Compute cosine similarity
        # query_embedding: (embedding_dim,)
        # threat_vectors: (num_threats, embedding_dim)
        # scores: (num_threats,)
        scores = np.dot(self._threat_vectors, query_embedding)
        
        # Get top-k indices
        top_indices = np.argsort(scores)[::-1][:top_k]
        
        # Filter by threshold and build results
        results = []
        for idx in top_indices:
            score = float(scores[idx])
            if score < self.threshold:
                continue
                
            metadata = self._threat_metadata[idx]
            results.append({
                "pattern": metadata['pattern'],
                "threat_type": metadata['threat_type'],
                "severity": metadata['severity'],
                "score": round(score, 4),
                "description": metadata.get('description', '')
            })
        
        return results
    
    def scan(self, text: str) -> Dict[str, Any]:
        """
        Complete scan: encode text and search for threats.
        
        Args:
            text: Input text to scan
            
        Returns:
            Dict with keys:
                - embedding_depth: embedding dimension
                - vector_hits: list of threat matches
                - max_score: highest threat score
                - threat_detected: boolean
        """
        self._lazy_init()
        
        # Generate embedding
        embedding = self.encode(text)
        
        # Search for threats
        hits = self.search(embedding)
        
        # Compute threat status
        max_score = max([hit['score'] for hit in hits], default=0.0)
        threat_detected = len(hits) > 0
        
        return {
            "embedding_depth": self.embedding_dim,
            "vector_hits": hits,
            "max_score": max_score,
            "threat_detected": threat_detected,
            "num_hits": len(hits)
        }
